---
import '../styles.css'; // Tailwind + DaisyUI
---

<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>T-Shirt Costalator</title>

		<!-- PapaParse first (global: window.Papa) -->
		<script
			src='https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.0/papaparse.min.js'
			defer></script>

		<!-- App logic: PURE JS (no TypeScript) -->
		<script defer>
			function byId(id) {
				var el = document.getElementById(id);
				if (!el) throw new Error('Missing element: #' + id);
				return el;
			}
			function readNumber(v) {
				var n = parseFloat(v || '');
				return isFinite(n) ? n : NaN;
			}

			function initCalculator(opts) {
				var prefix = opts.prefix;
				var csvUrl = opts.csvUrl;
				var unit = opts.unit || 'ft'; // "ft" or "in"

				function $input(name) {
					return byId(prefix + '-' + name);
				}
				function $select(name) {
					return byId(prefix + '-' + name);
				}
				function $span(name) {
					return byId(prefix + '-' + name);
				}

				function calculateCost() {
					var tshirtCost = readNumber($input('tshirtCost').value);
					var designWidth = readNumber($input('designWidth').value);
					var designLength = readNumber($input('designLength').value);

					var sel = $select('gangSheetSize');
					var parts = (sel.value || '').split(',');
					var gangSheetWidth = readNumber(parts[0]);
					var gangSheetLength = readNumber(parts[1]);
					var gangSheetCost = readNumber(parts[2]);

					if (
						!isNaN(tshirtCost) &&
						!isNaN(designWidth) &&
						!isNaN(designLength) &&
						!isNaN(gangSheetWidth) &&
						!isNaN(gangSheetLength) &&
						!isNaN(gangSheetCost)
					) {
						var acrossW = Math.floor(gangSheetWidth / designWidth);
						var acrossL = Math.floor(gangSheetLength / designLength);
						var totalGraphics =
							acrossW > 0 && acrossL > 0 ? acrossW * acrossL : 0;

						var costPerGraphic =
							totalGraphics > 0 ? gangSheetCost / totalGraphics : 0;
						var totalCost = tshirtCost + costPerGraphic;

						$span('totalCost').innerText = totalCost.toFixed(2);
						$span('designsPerSheet').innerText =
							totalGraphics > 0
								? totalGraphics + ' @ $' + costPerGraphic.toFixed(2)
								: '0 @ $0.00';
						$span('gangSheetCost').innerText = gangSheetCost.toFixed(2);
					}
				}

				function populateDropdown(data) {
					var dropdown = $select('gangSheetSize');
					dropdown.innerHTML = '';

					data.forEach(function (item, idx) {
						var w = item.Width,
							l = item.Length,
							p = item.Price;
						if (w && l && p) {
							var opt = document.createElement('option');
							if (unit === 'ft') {
								var ft = (readNumber(l) / 12).toFixed(2);
								opt.text = ft + 'ft';
							} else {
								opt.text = l + ' in';
							}
							opt.value = w + ',' + l + ',' + p;
							dropdown.add(opt);
						} else {
							console.error(
								'[' + prefix + '] Missing CSV row ' + (idx + 1),
								item
							);
						}
					});

					dropdown.addEventListener('change', calculateCost);
				}

				var Papa = window.Papa;
				if (!Papa) return console.error('PapaParse not loaded');

				Papa.parse(csvUrl, {
					download: true,
					header: true,
					complete: function (results) {
						populateDropdown(results.data || []);
						calculateCost();
					},
				});

				['tshirtCost', 'designWidth', 'designLength'].forEach(function (id) {
					$input(id).addEventListener('input', calculateCost);
				});
			}

			document.addEventListener('DOMContentLoaded', function () {
				// Jiffy → feet
				initCalculator({
					prefix: 'jiffy',
					csvUrl: '/costalator/price_table.csv',
					unit: 'ft',
				});

				// DTFDesign → inches
				initCalculator({
					prefix: 'dtfdesign',
					csvUrl: '/costalator/dtfdesign.csv',
					unit: 'in',
				});
			});
		</script>
	</head>

	<body
		class='min-h-screen flex items-start justify-center bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 p-4 md:p-8'
	>
		<div
			id='wrap'
			class='max-w-4xl w-full mx-auto bg-base-200 p-6 rounded-lg shadow-lg'
		>
			<h1 class='text-2xl font-bold mb-4 text-center'>T-Shirt Costalator</h1>

			<!-- Tabs (DaisyUI radio tabs) -->
			<div role='tablist' class='tabs tabs-boxed w-full mb-4'>
				<!-- Tab 1: Jiffy -->
				<input
					type='radio'
					name='calc-tabs'
					role='tab'
					class='tab'
					aria-label='Jiffy'
					checked
				/>
				<div role='tabpanel' class='tab-content bg-base-100 rounded-box p-4'>
					<div class='grid grid-cols-3 gap-4'>
						<div class='col-span-3 md:col-span-2'>
							<div class='flex flex-wrap gap-4'>
								<div class='flex flex-col w-full'>
									<label
										for='jiffy-tshirtCost'
										class='block text-sm font-medium text-gray-700'
										>T-Shirt Cost ($):</label
									>
									<input
										type='number'
										id='jiffy-tshirtCost'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='jiffy-designWidth'
										class='block text-sm font-medium text-gray-700'
										>Design Width (in):</label
									>
									<input
										type='number'
										id='jiffy-designWidth'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='jiffy-designLength'
										class='block text-sm font-medium text-gray-700'
										>Design Length (in):</label
									>
									<input
										type='number'
										id='jiffy-designLength'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='jiffy-gangSheetSize'
										class='block text-sm font-medium text-gray-700'
										>Gang Sheet Length (ft):</label
									>
									<select
										id='jiffy-gangSheetSize'
										class='select select-bordered w-full mt-1'></select>
								</div>
							</div>
						</div>

						<div class='col-span-3 md:col-span-1 flex flex-col gap-4'>
							<div
								class='card bg-fuchsia-500/25 border border-fuchsia-600 hover:border-fuchsia-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>T-Shirt Cost</p>
									<p class='text-2xl font-semibold'>
										$<span id='jiffy-totalCost'>0.00</span>
									</p>
								</div>
							</div>
							<div
								class='card bg-cyan-500/25 border border-cyan-600 hover:border-cyan-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>Total Designs</p>
									<p class='text-lg font-semibold'>
										<span id='jiffy-designsPerSheet'>0 @ $0.00</span>
									</p>
								</div>
							</div>
							<div
								class='card bg-teal-500/25 border border-teal-600 hover:border-teal-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>
										Gang Sheet Cost
									</p>
									<p class='text-2xl font-semibold'>
										$<span id='jiffy-gangSheetCost'>0.00</span>
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Tab 2: DTFDesign -->
				<input
					type='radio'
					name='calc-tabs'
					role='tab'
					class='tab'
					aria-label='DTFDesign'
				/>
				<div role='tabpanel' class='tab-content bg-base-100 rounded-box p-4'>
					<div class='grid grid-cols-3 gap-4'>
						<div class='col-span-3 md:col-span-2'>
							<div class='flex flex-wrap gap-4'>
								<div class='flex flex-col w-full'>
									<label
										for='dtfdesign-tshirtCost'
										class='block text-sm font-medium text-gray-700'
										>T-Shirt Cost ($):</label
									>
									<input
										type='number'
										id='dtfdesign-tshirtCost'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='dtfdesign-designWidth'
										class='block text-sm font-medium text-gray-700'
										>Design Width (in):</label
									>
									<input
										type='number'
										id='dtfdesign-designWidth'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='dtfdesign-designLength'
										class='block text-sm font-medium text-gray-700'
										>Design Length (in):</label
									>
									<input
										type='number'
										id='dtfdesign-designLength'
										step='0.01'
										class='input input-bordered w-full mt-1'
									/>
								</div>
								<div class='flex flex-col w-full'>
									<label
										for='dtfdesign-gangSheetSize'
										class='block text-sm font-medium text-gray-700'
										>Gang Sheet Length (ft):</label
									>
									<select
										id='dtfdesign-gangSheetSize'
										class='select select-bordered w-full mt-1'></select>
								</div>
							</div>
						</div>

						<div class='col-span-3 md:col-span-1 flex flex-col gap-4'>
							<div
								class='card bg-fuchsia-500/25 border border-fuchsia-600 hover:border-fuchsia-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>T-Shirt Cost</p>
									<p class='text-2xl font-semibold'>
										$<span id='dtfdesign-totalCost'>0.00</span>
									</p>
								</div>
							</div>
							<div
								class='card bg-cyan-500/25 border border-cyan-600 hover:border-cyan-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>Total Designs</p>
									<p class='text-lg font-semibold'>
										<span id='dtfdesign-designsPerSheet'>0 @ $0.00</span>
									</p>
								</div>
							</div>
							<div
								class='card bg-teal-500/25 border border-teal-600 hover:border-teal-400 text-white'
							>
								<div class='card-body items-center text-center'>
									<p class='text-sm font-medium text-gray-200'>
										Gang Sheet Cost
									</p>
									<p class='text-2xl font-semibold'>
										$<span id='dtfdesign-gangSheetCost'>0.00</span>
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- /tabs -->
		</div>
	</body>
</html>
